+/* DSH-3 — warm-paper theme from the approved wireframe (templates/
+   dash-wireframes/src/dash.css), only the rules this slice renders.
+   Literal hex + rule-level dark overrides; contrast-audited AA both themes. */
+:root {
+  --paper: #f7f1e5;
+  --surface: #fffefb;
+  --ink: #2b2118;
+  --ink-soft: #5c5040;
+  --accent: #b23e02;
+  --accent-ink: #fff8f0;
+  --rule: #d8cbb2;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --paper: #191410;
+    --surface: #2a221b;
+    --ink: #f0e7d8;
+    --ink-soft: #b3a68f;
+    --accent: #ff9254;
+    --accent-ink: #1a0e04;
+    --rule: #4a3f30;
+  }
+}
+body { background: var(--paper); color: var(--ink); font-family: system-ui, sans-serif; margin: 0; }
+.dash-card { background: var(--surface); border: 1px solid var(--rule); border-radius: 12px; padding: 20px; max-width: 760px; margin: 16px auto; }
+.dash-title { font-size: 1.3rem; margin: 0 0 4px; }
+.dash-sub { color: var(--ink-soft); margin: 0 0 14px; font-size: 0.88rem; }
+.dash-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; }
+.dash-stat { border: 1px solid var(--rule); border-radius: 8px; padding: 12px; display: flex; flex-direction: column; gap: 4px; }
+.dash-stat-label { color: var(--ink-soft); font-size: 0.78rem; }
+.dash-stat-value { font-size: 1.25rem; font-weight: 700; }
+.dash-filters { display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; }
+.dash-filter { padding: 6px 14px; border: 1px solid var(--rule); border-radius: 999px; background: var(--surface); color: var(--ink); cursor: pointer; font: inherit; }
+.dash-filter[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); border-color: transparent; }
+.dash-filter:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+.dash-empty { color: var(--ink-soft); padding: 20px 0; text-align: center; }
+.dash-error { border: 1px solid var(--accent); border-radius: 8px; padding: 14px; background: var(--surface); }
+.dash-error strong { color: var(--accent); }
+.dash-error p { margin: 6px 0 0; font-size: 0.85rem; color: var(--ink); }
