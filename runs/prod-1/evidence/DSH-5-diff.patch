+  });
+  it('guards max=0 and null — never NaN / divide-by-zero', () => {
+    expect(barPct(5, 0)).toBe(0);
+    expect(barPct(null, 0)).toBe(0);
+    expect(barPct(null, 10)).toBe(0);
+    expect(Number.isNaN(barPct(3, 0))).toBe(false);
